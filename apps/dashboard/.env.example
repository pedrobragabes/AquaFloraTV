# URL interna usada pelo proxy server-side do dashboard (Next.js -> API).
# Pode coincidir com NEXT_PUBLIC_API_URL no dev local.
API_INTERNAL_URL=http://localhost:7741
NEXT_PUBLIC_API_URL=http://localhost:7741

# Token compartilhado com a API (precisa ser idêntico ao API_ADMIN_TOKEN do apps/api).
API_ADMIN_TOKEN=change-me-min-32-chars-in-production

NEXTAUTH_SECRET=change-me-64-chars
DASHBOARD_SESSION_SECRET=change-me-64-chars
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_ADMIN_PASSWORD=troque-esta-senha
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
