PORT=7741
DATABASE_URL=file:./dev.db
# Em produção: gere segredos longos (>=32 chars). Comando: `openssl rand -hex 32`
JWT_SECRET=change-me-min-32-chars-in-production
SESSION_SECRET=change-me-min-32-chars-in-production
# Token compartilhado entre API e dashboard. Gere com `openssl rand -hex 32`.
API_ADMIN_TOKEN=change-me-min-32-chars-in-production
STORAGE_PATH=./storage
MAX_UPLOAD_MB=300
STORAGE_WARN_PCT=70
STORAGE_CRITICAL_PCT=85
MEDIA_RETENTION_DAYS=45
# Em produção, liste origens explicitamente (sem '*')
ALLOWED_ORIGINS=*
ADMIN_EMAILS=pedrobraga855@gmail.com
