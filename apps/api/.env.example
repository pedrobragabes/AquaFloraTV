PORT=7741
DATABASE_URL=file:./dev.db
# Token compartilhado entre API e dashboard. Gere com `openssl rand -hex 32`.
API_ADMIN_TOKEN=change-me-min-32-chars-in-production
STORAGE_PATH=../../storage
MAX_UPLOAD_MB=300
# O dashboard usa proxy server-side; esta origem explícita evita CORS aberto em produção.
ALLOWED_ORIGINS=http://localhost:7740
